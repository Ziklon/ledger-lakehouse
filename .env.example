# -----------------------------------------------------------------------------
# ledger-lakehouse configuration.
# Copy to .env (`make up` does this for you). Every endpoint and credential the
# code depends on lives here, so the same code runs locally and on AWS (Phase 3)
# by swapping values -- never by editing code.
# LOCAL-ONLY credentials below; never reuse them anywhere real.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ledger-lakehouse

# --- Source database (Postgres, the ledger OLTP) -----------------------------
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=ledger
PG_USER=ledger
PG_PASSWORD=ledger_local_only
# Least-privilege user Debezium connects with (REPLICATION + SELECT only)
PG_CDC_USER=debezium
PG_CDC_PASSWORD=debezium_local_only

# --- Object store (S3 API). Local: MinIO. AWS: leave S3_ENDPOINT empty -------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse_local_only
WAREHOUSE_BUCKET=warehouse
WAREHOUSE=s3://warehouse/

# --- Iceberg catalog. Local: REST. AWS: glue -----------------------------------
ICEBERG_CATALOG_TYPE=rest
ICEBERG_REST_URI=http://iceberg-rest:8181

# --- Kafka API + schema registry (Local: Redpanda. AWS: MSK + Glue SR) --------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SCHEMA_REGISTRY_URL=http://redpanda:8081
CONNECT_KEY_CONVERTER=io.confluent.connect.avro.AvroConverter
CONNECT_VALUE_CONVERTER=io.confluent.connect.avro.AvroConverter

# --- Host ports (change if they collide with something on your laptop) -------
HOST_PG_PORT=15432
HOST_KAFKA_PORT=19092
HOST_SCHEMA_REGISTRY_PORT=18081
HOST_CONNECT_PORT=8083
HOST_MINIO_PORT=9000
HOST_MINIO_CONSOLE_PORT=9001
HOST_ICEBERG_REST_PORT=8181
HOST_TRINO_PORT=18080
HOST_REDPANDA_CONSOLE_PORT=8088
